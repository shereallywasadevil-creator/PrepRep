<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrepRep</AssemblyName>
    <RootNamespace>PrepRep</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>PrepRep</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>
  <ItemGroup>
    <!-- The screens travel inside the exe and are unpacked on start. -->
    <EmbeddedResource Include="web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="app.ico" />
    <EmbeddedResource Include="embed\python.zip" LogicalName="python.zip" Condition="Exists('embed\python.zip')" />
  </ItemGroup>
</Project>
